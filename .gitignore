# Secrets — never commit
.env
*.pem
*.key

# Runtime data — created on-box by gittar.sh or containers
postgres-data/
open-webui-data/
qdrant-data/
n8n-data/
models/
backups/

# Python bytecode (anywhere — validation compiles happen outside ingestion/ too)
__pycache__/

# Ingestion worker state (created on-box by the periodic worker)
ingestion/.ingest-manifest.json

# OS junk
.DS_Store
Thumbs.db
